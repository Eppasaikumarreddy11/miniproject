{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Backend (Node)",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/server.js",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "name": "Serve Frontend (npm)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "serve-frontend"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Open Frontend in Browser (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Run Full Stack",
      "configurations": [
        "Run Backend (Node)",
        "Serve Frontend (npm)",
        "Open Frontend in Browser (Chrome)"
      ]
    }
  ]
}
